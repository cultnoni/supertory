# Copy this file to .env and fill in your Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
PEXELS_API_KEY=

# Optional: desktop sync (pairing). Leave blank to run fully offline.
# Sign in from the admin user-management tab; do not put account credentials here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
