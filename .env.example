# Copy this file to .env and fill in your Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
PEXELS_API_KEY=

# Optional: desktop sync (pairing). Leave blank to run fully offline.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_USER_EMAIL=
SUPABASE_USER_PASSWORD=
