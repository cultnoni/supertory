{
  "type": "object",
  "additionalProperties": false,
  "required": ["events", "threads", "payoffs", "settings"],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["para", "kind", "what", "quote"],
        "properties": {
          "para": {"type": "integer"},
          "kind": {"type": "string", "enum": ["revenge", "growth", "relation", "payoff", "emotion", "status", "other"]},
          "what": {"type": "string"},
          "quote": {"type": "string"}
        }
      }
    },
    "threads": {"type": "array", "items": {"type": "string"}},
    "payoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["para", "what"],
        "properties": {"para": {"type": "integer"}, "what": {"type": "string"}}
      }
    },
    "settings": {"type": "array", "items": {"type": "string"}}
  }
}
